# BACKEND ONLY — never put real credentials in Git or the mobile/web client.
HAYTILE_ENV=development
HAYTILE_PUBLIC_ORIGIN=http://localhost:3000
HAYTILE_GEMINI_API_KEY=
# Local development DB only; production must use private credentials.
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://haytile@127.0.0.1:5432/haytile
REDIS_URL=redis://127.0.0.1:6379/0
HAYTILE_DATA_DIR=/workspace/haytile-ai/.local
# Omit signing key in dev to create a private persistent key automatically.
HAYTILE_SIGNING_KEY=
HAYTILE_FREE_IMAGES_PER_DAY=8
HAYTILE_DAILY_JOB_LIMIT=100
# Temporary-hosting AI trials are opt-in and still incur provider charges.
HAYTILE_TRIAL_AI=0
HAYTILE_TRIAL_MAX_VIDEO_SECONDS=8
HAYTILE_TRIAL_MAX_EPISODE_SECONDS=16
HAYTILE_TRIAL_PER_STUDIO_PER_DAY=2
HAYTILE_PROVIDER_POLL_SECONDS=600
# Server-only configuration; enable only after verifying access and accepting costs.
HAYTILE_OPERATOR_BILLING_ACK=0
HAYTILE_MODEL_CONFIG=[]
# Leave storage variables unset for private local development files.
# firebase selects private Firebase Cloud Storage; credentials are backend-only.
STORAGE_PROVIDER=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT_JSON=
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_REGION=us-east-1
# AWS defaults to AES256. Supabase S3 requires provider-managed (no SSE header).
STORAGE_SERVER_SIDE_ENCRYPTION=AES256
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
# WEB SERVER ONLY
HAYTILE_API_URL=http://127.0.0.1:8000
# MOBILE: public address and project metadata, never secrets.
EXPO_PUBLIC_API_URL=
HAYTILE_EAS_PROJECT_ID=
# Cloud deployment control only. Do not copy the Render control key into the deployed app.
HAYTILE_RENDER_API_KEY=
